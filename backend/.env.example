# Nusxa oling: .env va qiymatlarni to'ldiring
# MySQL (oldindan baza yarating: CREATE DATABASE zoomplatform CHARACTER SET utf8mb4;)
DATABASE_URL=mysql+aiomysql://zoom:PAROL@127.0.0.1:3306/zoomplatform

# Telegram bot (BotFather dan)
BOT_TOKEN=123456:ABC...
# Adminlar Telegram ID lari (vergul bilan) - ogohlantirish va oylik hisobot shularga boradi
ADMIN_TELEGRAM_IDS=

# Sirlar: scripts/gen_secrets.py bilan yarating
JWT_SECRET=
FERNET_KEY=

# Server
HOST=0.0.0.0
PORT=8000
COOKIE_SECURE=false
TIMEZONE=Asia/Tashkent

# Dars sozlamalari
BLOCK_MINUTES=40
LEAD_SECONDS=60
MAX_BLOCKS=10
ACCOUNT_BUFFER_MINUTES=3

# --- Alwaysdata uchun (deploy/ALWAYSDATA.md) ---
# DATABASE_URL=mysql+aiomysql://HISOB:PAROL@mysql-HISOB.alwaysdata.net:3306/HISOB_zoom
# COOKIE_SECURE=true   (alwaysdata HTTPS beradi)
